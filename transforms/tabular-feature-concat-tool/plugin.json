{
  "name": "Tabular Feature Concat",
  "version": "0.1.0-dev2",
  "title": "Tabular Feature Concat",
  "description": "Concatenate Nyxus channel features from multiple files, rename channels, and associate metadata.",
  "author": "Hamdah Shafqat Abbasi (hamdahshafqat.abbasi@nih.gov)",
  "institution": "National Center for Advancing Translational Sciences, National Institutes of Health",
  "repository": "https://github.com/PolusAI/tabular-tools",
  "website": "https://ncats.nih.gov/preclinical/core/informatics",
  "citation": "",
  "containerId": "polusai/tabular-feature-concat-tool:0.1.0-dev2",
  "baseCommand": [
    "python3",
    "-m",
    "polus.tabular.transforms.feature_concat"
  ],
  "inputs": [
    {
      "name": "inpDir",
      "type": "genericData",
      "description": "Input data collection to be processed by this plugin",
      "required": true
    },
    {
      "name": "filePattern",
      "type": "string",
      "description": "Pattern to parse input files",
      "required": true
    },
    {
      "name": "groupBy",
      "type": "string",
      "description": "Group files based on variable",
      "required": true
    },
    {
      "name": "channelName",
      "type": "string",
      "description": "Variable for channel name",
      "required": true
    },
    {
      "name": "features",
      "type": "string",
      "description": "List of selected features",
      "required": false
    },
    {
      "name": "metaDir",
      "type": "genericData",
      "description": "Path to metadata file",
      "required": false
    },
    {
      "name": "plateName",
      "type": "string",
      "description": "Plate name for merging with metadata file",
      "required": false
    },
    {
      "name": "preview",
      "type": "boolean",
      "title": "Preview",
      "description": "Generate an output preview.",
      "required": "False"
    }
  ],
  "outputs": [
    {
      "name": "outDir",
      "type": "genericData",
      "description": "Output data collection"
    }
  ],
  "ui": [
    {
      "key": "inputs.inpDir",
      "title": "inpDir",
      "description": "Input data collection to be processed by this plugin"
    },
    {
      "key": "inputs.filePattern",
      "title": "filePattern",
      "description": "Pattern to parse input files"
    },
    {
      "key": "inputs.groupBy",
      "title": "groupBy",
      "description": "Group files based on variable"
    },
    {
      "key": "inputs.channelName",
      "title": "channelName",
      "description": "Variable for channel name"
    },
    {
      "key": "inputs.features",
      "title": "features",
      "description": "List of selected features"
    },
    {
      "key": "inputs.metaDir",
      "title": "metaDir",
      "description": "Path to metadata file"
    },
    {
      "key": "inputs.plateName",
      "title": "plateName",
      "description": "Plate name for merging with metadata file"
    }
  ]
}